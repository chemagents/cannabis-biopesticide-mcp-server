# --- MCP transport (matches the other CoScientist MCP servers) ---
CANPEST_MCP_HOST=0.0.0.0
CANPEST_MCP_PORT=7331
CANPEST_MCP_PATH=/mcp

# --- data (bundled from the authors' rmt_canpest package) ---
# CANPEST_DATA_PATH=/app/server/data/canpest_data.csv
# CANPEST_RTE_PATH=/app/server/data/rte.csv
# Optional: bundled DMPNN-SD metabolite probabilities (cols: ligand_id, prob). If present,
# predict_biopesticides reports the exact 1010 / 40.97%; if absent, it falls back to HGB.
# CANPEST_DMPNN_PRED_PATH=/app/server/data/dmpnn_pred.csv

# --- RMT feature selection (Section 3.3) ---
CANPEST_RMT_INNER_SPLITS=4
CANPEST_RMT_RANK_BY=hybrid
CANPEST_RANDOM_STATE=42

# --- QSAR model backend (open analogue of DMPNN-SD; HGB reproduces ~0.93 torch-free) ---
CANPEST_MODEL_BACKEND=hgb
CANPEST_CANDIDATE_PROBABILITY=0.70

# --- applicability domain ---
CANPEST_AD_K_NEIGHBORS=5
CANPEST_AD_THRESHOLD_SIGMA=2.0

# --- chemical-space clustering ---
CANPEST_MORGAN_RADIUS=2
CANPEST_MORGAN_NBITS=2048
CANPEST_CLUSTER_FINGERPRINT=differential

# --- figure artifacts: local dir (default) or S3-compatible bucket ---
CANPEST_ARTIFACTS_DIR=/app/artifacts
# CANPEST_ARTIFACT_URL_BASE=
CANPEST_S3_ENDPOINT_URL=
CANPEST_S3_PUBLIC_ENDPOINT_URL=
CANPEST_S3_BUCKET_NAME=
CANPEST_S3_ACCESS_KEY=
CANPEST_S3_SECRET_KEY=
CANPEST_S3_REGION=us-east-1
CANPEST_S3_ADDRESSING_STYLE=path
# CANPEST_S3_CA_BUNDLE=/run/secrets/internal-ca.pem
CANPEST_S3_URL_EXPIRATION=3600
# Strict by default; enable only when a caller can actually consume local paths.
CANPEST_S3_ALLOW_LOCAL_FALLBACK=false
